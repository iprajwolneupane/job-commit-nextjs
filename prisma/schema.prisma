// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppliedJobResponseEnum {
  NORESPONSE
  REJECTED
  INTERVIEW
  SCREENINGQUESTIONS
  OFFER
  ACCEPTED
  NOTINTERESTED
}

enum ScrapeStatus {
  PENDING
  SCRAPING
  COMPLETED
  FAILED
  SKIPPED
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @unique
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id @default(cuid())
  username      String
  email         String       @unique
  passwordHash  String?
  emailVerified DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  session       Session?
  appliedJobs   AppliedJob[]
  documents     Document[]
  platforms     Platform[]
  linkedInUrl   String?
  githubUrl     String?
  portfolioUrl  String?
  contactNumber String?
  skills        String[]

  @@index([createdAt, id, email])
}

model Platform {
  id          String       @id @default(cuid())
  userId      String
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appliedJobs AppliedJob[]

  @@unique([userId, name])
  @@index([userId])
}

model AppliedJob {
  id          String                 @id @default(cuid())
  userId      String
  platformId  String
  appliedDate DateTime
  company     String
  position    String
  sendMailAt  DateTime
  sentMail    Boolean                @default(false)
  response    AppliedJobResponseEnum @default(NORESPONSE)
  link        String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    Platform               @relation(fields: [platformId], references: [id], onDelete: Restrict)
  scrappedJob ScrappedJob?

  @@index([userId])
  @@index([userId, platformId])
  @@index([userId, appliedDate])
  @@index([userId, response])
  @@index([userId, sendMailAt])
}

model ScrappedJob {
  id                  String       @id @default(cuid())
  appliedJobId        String       @unique
  link                String
  title               String?
  company             String?
  description         String?      @db.Text
  scrapeStatus        ScrapeStatus @default(PENDING)
  scrapedLink         String?
  scrapedAt           DateTime?
  scrapeAttempts      Int          @default(0)
  scrapeError         String?
  lastScrapeAttemptAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  appliedJob          AppliedJob   @relation(fields: [appliedJobId], references: [id], onDelete: Cascade)

  @@index([scrapeStatus])
  @@index([scrapedAt])
}

model Document {
  id        BigInt                      @id @default(autoincrement())
  userId    String
  content   String?
  metadata  Json?
  embedding Unsupported("vector(768)")?
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("documents")
}
